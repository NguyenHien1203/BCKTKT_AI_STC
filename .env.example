POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=financial_dw

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=financial-reports
MINIO_SECURE=false

# AUTH_PROVIDER=local  -> xác thực nội bộ bằng password_hash (mặc định, không cần Keycloak)
# AUTH_PROVIDER=keycloak -> SSO thật qua Keycloak (Authorization Code Flow + PKCE, xem ARCHITECTURE.md - ADR-003)
AUTH_PROVIDER=local
# KEYCLOAK_PUBLIC_BASE_URL: URL Keycloak mà TRÌNH DUYỆT gọi được (redirect đăng nhập, đổi code lấy token).
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=hungyen-financial
# Client "auth-identity-service" là public client (SPA + PKCE) -> không cần KEYCLOAK_CLIENT_SECRET.
KEYCLOAK_CLIENT_ID=auth-identity-service
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me_in_production   # (.env thật: app_password)

# UC-047 (nâng cấp) — Superset Embedded Dashboard SDK + Guest Token.
# Xem ARCHITECTURE.md - ADR-005.
SUPERSET_SECRET_KEY=change_me_in_production
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_in_production
# URL trình duyệt gọi được để tải iframe/script nhúng dashboard.
SUPERSET_PUBLIC_URL=http://localhost:8088
# Domain frontend được phép nhúng iframe Superset (CSP frame-ancestors),
# nhiều domain cách nhau bằng dấu phẩy.
SUPERSET_ALLOWED_EMBEDDED_ORIGINS=http://localhost:5173
# Khoá ký guest token — PHẢI khác SUPERSET_SECRET_KEY.
SUPERSET_GUEST_TOKEN_JWT_SECRET=change_me_in_production
SUPERSET_GUEST_TOKEN_TTL_SECONDS=300
# Tài khoản DỊCH VỤ riêng (quyền tối thiểu — chỉ phát hành guest token),
# tạo thủ công trong Superset sau lần khởi động đầu tiên — KHÔNG dùng
# SUPERSET_ADMIN_USERNAME/PASSWORD ở trên cho reporting-service.
SUPERSET_GUEST_TOKEN_USERNAME=
SUPERSET_GUEST_TOKEN_PASSWORD=

# UC-051 — "Cấu hình báo cáo theo lịch": máy chủ SMTP dùng để reporting-service
# tự động gửi email báo cáo theo lịch (hàng ngày/hàng tuần/hàng tháng).
# Để trống REPORT_SMTP_HOST -> dùng InMemoryReportEmailSender (chỉ ghi log,
# không gửi thật, phù hợp dev/test) — xem
# services/reporting-service/app/infrastructure/report_email_sender.py.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_USE_TLS=true
REPORT_SMTP_FROM=bao-cao@stc.gov.vn
# Bật tác vụ định kỳ (cron nội bộ, APScheduler) quét lịch báo cáo tới hạn.
# Mặc định false — chỉ bật ở môi trường muốn thật sự gửi email tự động
# (tránh chạy nền ngoài ý muốn khi dev/test).
REPORT_SCHEDULER_ENABLED=false
# Chu kỳ quét lịch báo cáo tới hạn (giây).
REPORT_SCHEDULER_POLL_SECONDS=60